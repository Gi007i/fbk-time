# FBK-Time Gunicorn Service for RHEL 9
# /etc/systemd/system/fbk-time.service
#
# Install:
#   1. Set ownership: chown -R nginx:nginx /var/www/fbk-time
#   2. Create backup directory: install -d -m 700 -o nginx -g nginx /var/backups/fbk-time
#      (SELinux context: see docs/deployment/rhel/configure-systemd-service.md)
#   3. Copy this file: cp systemd-rhel.service.example /etc/systemd/system/fbk-time.service
#   4. Reload systemd: systemctl daemon-reload
#   5. Enable service: systemctl enable --now fbk-time

[Unit]
Description=FBK-Time Gunicorn Application Server
Documentation=https://gunicorn.org/
After=network.target
# RequiresMountsFor=/mnt/backup

[Service]
Type=notify
User=nginx
Group=nginx
WorkingDirectory=/var/www/fbk-time
Environment=PYTHONPATH=/var/www/fbk-time
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/fbk-time/venv/bin/gunicorn --config gunicorn.conf.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fbk-time

# Security hardening (RHEL 9 systemd)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# ReadWritePaths=/var/www/fbk-time /mnt/backup
ReadWritePaths=/var/www/fbk-time /var/backups/fbk-time
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
