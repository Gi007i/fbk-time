{
  "system": {
    "database": {
      "path": "data/fbk-time.db"
    },
    "logs": {
      "access_log": "logs/gunicorn_access.log",
      "error_log": "logs/gunicorn_error.log"
    },
    "licenses": {
      "path": "data/licenses.json",
      "manual_path": "data/manual-licenses.json"
    },
    "server": {
      "host": "127.0.0.1",
      "port": 6000,
      "runtime_path": "data/run"
    },
    "backup": {
      "directory": "/tmp/fbk-time-backups"
    },
    "settings_template_path": "data/settings-template.json",
    "security": {
      "session": {
        "lifetime_hours": 10,
        "idle_timeout_minutes": 30,
        "idle_warning_seconds": 60,
        "remember_cookie_days": 7
      },
      "argon2": {
        "time_cost": 3,
        "memory_cost": 65536,
        "parallelism": 4
      }
    }
  }
}
